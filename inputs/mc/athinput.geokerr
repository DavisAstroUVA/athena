<comment>
problem   = Geodesics in Kerr spacetime
reference =
configure = --prob=mc_geokerr -mc --coord=kerr-schild -g

<job>
problem_id = mcgk   # problem ID: basename of output filenames

<output1>
file_type = phlist
nuser     = 6

<output2>
file_type = traj
steplimit = 100000

<mesh>
nx1        = 100        # Number of zones in X1-direction
x1min      = 1.0    # minimum value of X1
x1max      = 100         # maximum value of X1
ix1_mc_bc  = absorb     # inner-X1 boundary flag
ox1_mc_bc  = escape     # outer-X1 boundary flag

nx2        = 8        # Number of zones in X2-direction
x2min      = 0          # minimum value of X2
x2max      = 3.14159    # maximum value of X2
ix2_mc_bc  = polar      # inner-X2 boundary flag
ox2_mc_bc  = polar      # outer-X2 boundary flag

nx3        = 8        # Number of zones in X3-direction
x3min      = 0          # minimum value of X3
x3max      = 6.28318    # maximum value of X3
ix3_mc_bc  = periodic   # inner-X3 boundary flag
ox3_mc_bc  = periodic   # outer-X3 boundary flag

<coord>
m = 1.0  # black hole mass M
a = 0.9  # black hole spin a (0 <= a/M < 1)

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v

<montecarlo>
nphot = 16
iseed     = 121500
emin      = 1.0
emax      = 100.0
scattering = none
emission   = user
absorption = none
polarized = none
stepsize = 1.0e-3
boyerlindquist = true
varystep = true
raytrace = true

<problem>
phi = 0.      # azimuthal angle in pi radians
theta = 0.5      # polar angle in pi radians
radius = 1.01 # in units of isco radius
#phik = 0.4
#muk = 0.