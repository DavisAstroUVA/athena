#!/bin/bash
<comment>
problem = Base hot jupiter problem - volume emissivity of Lya, resonant scattering, ionization tracked with passive scalar
reference =
configure = --coord spherical_polar --prob mc_hotjupiter -mc -mpi -hdf5 -h5double --nscalars=1

<job>
problem_id = mc_hotjupiter

<output0>
file_type = hst
dt = 5.e2

<output1>
id = prim
file_type = hdf5
variable = prim
xdmf = 0
dt = 5.e2

<output2>
id = cooling
file_type = hdf5
variable = uov5
xdmf = 0
dt = 5.e2

<output3>
id = mclab
file_type = hdf5
variable = mclab
xdmf = 0
dt = 5.e2

<output4>
id = mcsrc
file_type = hdf5
variable = mcsrc
xdmf = 0
dt = 5.e2

#<output5>
#id = phlist
#file_type = phlist
#dt = 1.e3

<time>
cfl_number = 0.3
nlim = -1
tlim = 1.e4
ncycle_out = 1

<mesh>
nx1 = 128
x1min = 1.e10
x1max = 8.e10
ix1_bc = user
ox1_bc = user
ix1_mc_bc = absorb
ox1_mc_bc = escape
x1rat = 1.02

nx2 = 33
x2min = 0.0
x2max = 3.141592653589793
ix2_bc = periodic
ox2_bc = periodic
ix2_mc_bc = periodic
ox2_mc_bc = periodic

nx3 = 33
x3min = 0.0
x3max = 6.283185307179586
ix3_bc = periodic
ox3_bc = periodic
ix3_mc_bc = periodic
ox3_mc_bc = periodic

<meshblock>
nx1 = 8
nx2 = 3
nx3 = 3

<hydro>
gamma = 1.6666666666667
active = true
dfloor = 1.e-30
pfloor = 1.e-30
sfloor = 1.e-30

<montecarlo>
iseed = 123456      # pseudorandom number seed
ntype = 1
tmax = 1.e5
scattering = user
emission = multi
absorption = user
equal_weight = true
general_pusher = true
abs_method = tau
stepsize = 0.1
varystep = true
dynamic = true
coupled = true
#boosts = true

<problem>
nlyastr = 0  # number of stellar lya samples
nlyarec = 0
#nlyarec = 100000  # number of recomb lya samples
nion = 1000000
#nion    = 1000000  # number of euv photon samples
user_dt = 1.e11

# Flags for turning on individual sources of emission
lya_volume_emis = false
lya_surface_emis = false
ion_surface_emis = true

#ion_eqwt = true  # use eq. weight scheme for euv
#lys_eqwt = true  # use eq. weight scheme for stellar lya
#lyr_eqwt = true  # use eq. weight scheme for recomb. lya

# Debug flag for turning off opacity entirely
zero_opacity = false
escape_after_scatter = false

# Geometry
incident_from_z = false

# UNCOMMENT TO USE POINT MASS GRAVITY
GM = 9.e22

# UNCOMMENT TO USE TIDAL GRAVITY
gm_star = 1.5e26
orbit_sep = 0.05

# PLANET ATMOSPHERIC PROPERTIES
nbase = 1.e10            # Pressure at base of atmosphere (microbar)
isothermal_temp = 7.e3   # Isothermal temperature of the atmosphere (K)
wind = true
mdot = 1.e10

# RADIATION SOURCES
lya_flux = 2.8e3
ion_flux = 1.1e3 # from Woods solar spectrum above 13.6 eV

# Lyman Alpha line properties
linewidth = 67.0 # km/s
linewidth_cutoff = 335.0 # km/s, 5 sigma, also cutoff for determining photon type

# Ionizing radiation properties
numin = 3.28846537e+15
numax = 6.e+16
powa = 2.
chromo_temp = 7.e3
pow_law = true

# Initialize ionization fraction from another file
initialize_scalar_from_file = false
initialize_pressure_from_file = false
initialize_velocity_from_file = false
initialize_density_from_file = false
input_filename = 
dataset_prim = /prim

#l_cgs = 1.e10
