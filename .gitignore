doc/**/*.aux
doc/**/*.log
doc/**/*.pdf
doc/**/*.toc

# Agent tooling.  Empty .claude directories appear all over the tree as a side effect of
# running commands in them; the one at the repository root holds real project
# configuration and is deliberately left visible.
.claude/
!/.claude/
.mcp.json
